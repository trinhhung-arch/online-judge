<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.oj</groupId>
	<artifactId>oj-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>oj-api</name>
	<description />
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>

	<!--
		Spring Boot 4.1 khai báo ${testcontainers.version} (2.0.5) nhưng không quản trực tiếp
		từng artifact org.testcontainers:* — phải import BOM. Import ở đây để hai artifact dưới
		không tự ghi số và luôn khớp nhau: lệch version giữa chúng là lỗi chỉ hiện lúc chạy,
		dưới dạng NoSuchMethodError.

		⚠️ Testcontainers 2.x đổi tên artifact: `testcontainers-postgresql` chứ không phải
		`postgresql` như bản 1.x mà mọi hướng dẫn trên mạng còn viết.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!--
			JdbcClient + HikariCP: nền của DataSourceConfig (hai pool) và của mọi
			repository. Trước đây nó chỉ đến GIÁN TIẾP qua starter-flyway — nghĩa là
			một lần nâng phiên bản Flyway có thể làm cả hệ thống không biên dịch được.
			Khai báo thẳng ra.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!-- <dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency> -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers — Postgres THẬT cho integration test, KHÔNG H2.
			H2 không có partial index, FOR UPDATE SKIP LOCKED, hay ON CONFLICT ... WHERE —
			tức là nó không có đúng ba thứ mà toàn bộ thiết kế hàng đợi dựa vào. Một bộ test
			xanh trên H2 sẽ nói dối về chính những bất biến quan trọng nhất (postgres-design
			mục 13, build-order Bước M1-7).

			@ServiceConnection của spring-boot-testcontainers tự nối container vào cấu hình.
			Cần vì hệ thống có HAI pool (oj.datasource.app / judge) phải trỏ cùng một container;
			bơm tay bằng @DynamicPropertySource là thêm hai chỗ để sai, và sai kiểu đó thì test
			vẫn xanh nhưng chạy nhầm pool.

			Phiên bản do BOM của Spring Boot quản — không tự ghi số.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.oj</groupId>
			<artifactId>oj-contract</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				★ BẮT BUỘC, nếu không thì toàn bộ integration test KHÔNG BAO GIỜ CHẠY.

				Surefire chỉ nhận *Test.java; các lớp *IT.java là việc của Failsafe, và nó
				không tự bật. Thiếu khối này thì `mvn verify` vẫn xanh trong khi bốn chaos
				test và SchemaInvariantsIT nằm im — tức là R1 và R2 lại quay về được ép bằng
				lời hứa, đúng thứ chúng sinh ra để thay thế.

				Failsafe chạy ở pha integration-test và `verify` mới báo lỗi, nên một IT đỏ
				không làm hỏng `mvn install` giữa chừng mà vẫn fail build. Phiên bản do
				parent của Spring Boot quản.

				⚠️ Cần Docker chạy được trên máy (Testcontainers). CI ubuntu-latest có sẵn.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!--
						★ Thứ tự CỐ ĐỊNH, và đây là một quyết định chứ không phải sở thích.

						Mặc định của Failsafe là `filesystem` — thứ tự thư mục trả về, tức là
						thứ tự tạo inode. Nó KHÁC NHAU giữa máy dev và runner CI, nên một bộ
						IT có phụ thuộc thứ tự sẽ xanh ở đây và đỏ ở kia, và không ai tái hiện
						được. Bộ IT này dùng CHUNG một Postgres (container singleton), nên
						phụ thuộc thứ tự là chuyện có thể xảy ra thật.

						`alphabetical` làm CI và máy dev chạy đúng một thứ tự. Nó không SỬA
						được phụ thuộc thứ tự — `PostgresIT.resetHotTables()` mới làm việc đó
						— nhưng nó biến "đỏ ngẫu nhiên ở một máy" thành "đỏ ở mọi máy", và
						một lỗi tái hiện được là một lỗi sửa được.
					-->
					<runOrder>alphabetical</runOrder>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>