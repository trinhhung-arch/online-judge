		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.oj</groupId>
			<artifactId>oj-contract</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				★ BẮT BUỘC, nếu không thì toàn bộ integration test KHÔNG BAO GIỜ CHẠY.

				Surefire chỉ nhận *Test.java; các lớp *IT.java là việc của Failsafe, và nó
				không tự bật. Thiếu khối này thì `mvn verify` vẫn xanh trong khi bốn chaos
				test và SchemaInvariantsIT nằm im — tức là R1 và R2 lại quay về được ép bằng
				lời hứa, đúng thứ chúng sinh ra để thay thế.

				Failsafe chạy ở pha integration-test và `verify` mới báo lỗi, nên một IT đỏ
				không làm hỏng `mvn install` giữa chừng mà vẫn fail build. Phiên bản do
				parent của Spring Boot quản.

				⚠️ Cần Docker chạy được trên máy (Testcontainers). CI ubuntu-latest có sẵn.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!--
						★ Thứ tự CỐ ĐỊNH, và đây là một quyết định chứ không phải sở thích.

						Mặc định của Failsafe là `filesystem` — thứ tự thư mục trả về, tức là
						thứ tự tạo inode. Nó KHÁC NHAU giữa máy dev và runner CI, nên một bộ
						IT có phụ thuộc thứ tự sẽ xanh ở đây và đỏ ở kia, và không ai tái hiện
						được. Bộ IT này dùng CHUNG một Postgres (container singleton), nên
						phụ thuộc thứ tự là chuyện có thể xảy ra thật.

						`alphabetical` làm CI và máy dev chạy đúng một thứ tự. Nó không SỬA
						được phụ thuộc thứ tự — `PostgresIT.resetHotTables()` mới làm việc đó
						— nhưng nó biến "đỏ ngẫu nhiên ở một máy" thành "đỏ ở mọi máy", và
						một lỗi tái hiện được là một lỗi sửa được.
					-->
					<runOrder>alphabetical</runOrder>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<!--
					★ CỐ Ý KHÔNG ghi <version>. spring-boot-starter-parent quản lý nó bằng
					${flyway.version} — đúng con số đang dùng cho flyway-core (12.4.0). Ghi
					số ở đây là tạo ra một chỗ thứ hai để lệch, và lệch phiên bản Flyway
					nghĩa là thuật toán băm khác: `repair` ghi vào một checksum mà Flyway
					của ứng dụng không công nhận, rồi app vẫn đỏ y như trước khi repair.

					★ KHÔNG chạy trong vòng đời build. Không có <executions>, nên `mvn
					verify` không đụng tới nó. Đây là công cụ gọi tay khi có sự cố, không
					phải một bước của quy trình dựng.

					Việc duy nhất nó sinh ra để làm:

					    ./mvnw -pl oj-api flyway:repair

					dùng khi Flyway từ chối khởi động vì "checksum mismatch" — tức một file
					V__ đã commit bị sửa (điều #6 của CLAUDE.md). `repair` tính lại checksum
					từ file rồi ghi vào flyway_schema_history. Nó KHÔNG chạy lại migration.

					⚠️ `repair` chỉ đúng khi phần SQL THỰC THI không đổi. Nếu DDL có đổi thật
					thì repair là nói dối: nó tuyên bố "DB khớp file" trong khi DB thiếu đúng
					phần vừa thêm. Ca ấy phải trả file về bản đã commit rồi viết V<n+1> mới.
					Cách kiểm 30 giây: bỏ mọi dòng chú thích của hai bản rồi diff phần còn lại.
				-->
				<configuration>
					<!--
						★ Tắt `clean` VĨNH VIỄN, và đây là lý do plugin này suýt không đáng thêm.

						`mvn flyway:clean` XOÁ TOÀN BỘ schema — mọi bảng, mọi bài nộp, mọi
						verdict. Một lần gõ nhầm `clean` thay vì `repair` trên máy có dữ liệu
						thật là phá thẳng vào lời hứa số hai của hệ thống này ("không mất bài
						nộp"), và không có bước xác nhận nào chen vào giữa.

						Flyway 10+ mặc định đã là true, nhưng viết ra ở đây để nó là một quyết
						định đọc được, không phải một mặc định may mắn có thể đổi ở bản sau.
					-->
					<cleanDisabled>true</cleanDisabled>
				</configuration>
			</plugin>

			<!--
			  ★ JaCoCo — SLO M2 (nfrplan.md Phần 1): "Coverage domain+application ≥ 80%".

			  Trước 2026-09-21 không có plugin này ở bất kỳ pom nào, nên M2 là một SLO KHÔNG ĐO
			  ĐƯỢC — cau-truc-source.md đã ghi đúng như vậy. Một chỉ số không đo được thì không
			  phải chỉ số, nó là một câu khẩu hiệu.

			  Chỉ đo `domain` và `application`: đó là chỗ nghiệp vụ sống. `infrastructure` được
			  bộ IT trên Postgres thật che, `api` là DTO và ánh xạ, và ép cả hai vào con số làm
			  người ta viết test cho getter để kéo phần trăm lên — đúng thứ SLO này không muốn.

					Đo trước rồi mới chốt ngưỡng: 2026-09-21, unit+IT cho domain 83.2% và
					application 85.6%, tổng 84.9%. Ngưỡng đặt ở 80% đúng theo SLO M2 — còn dư
					gần 5 điểm, đủ để một lần refactor không làm đỏ build một cách vô cớ.

					⚠️ BẪY: chỉ chạy unit test thì con số là 64.4%, không phải 84.9% — phần lớn
					`application` được bộ IT trên Postgres thật che. Nên `check` nằm ở phase
					`verify`, SAU failsafe. `mvn verify -DskipITs` sẽ đỏ, và đỏ ĐÚNG: nó nghĩa
					là "bạn chưa chạy thứ tạo ra phần lớn coverage".
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<includes>
						<include>dev/oj/**/domain/**</include>
						<include>dev/oj/**/application/**</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<id>gan-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>bao-cao</id>
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<execution>
						<id>cong-slo-m2</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>