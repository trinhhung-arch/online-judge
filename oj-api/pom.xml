	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.oj</groupId>
	<artifactId>oj-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>oj-api</name>
	<description />
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>21</java.version>

		<!--
			★ Ba giá trị này PHẢI khớp mặc định của `spring.flyway.*` trong
			application.yml. HopDongVanHanhTest đối chiếu hai file và đỏ khi chúng lệch.

			Vì sao đáng canh: `flyway:repair` sửa bảng `flyway_schema_history` của
			DATABASE mà nó nối tới. Lệch một chữ trong URL là nó sửa đúng thao tác ấy
			trên một database khác — thành công, im lặng, và cái đang hỏng thì vẫn hỏng.

			Đổi DB của app bằng OJ_DB_URL thì phải truyền -Dflyway.url tương ứng:
			Maven không có cú pháp ${BIEN:mac-dinh} như Spring, nên hai bên không tự
			bám theo nhau được. Ca kiểm chỉ giữ được phần MẶC ĐỊNH.
		-->
		<flyway.url>jdbc:postgresql://localhost:5432/ojdb</flyway.url>
		<flyway.user>ojuser</flyway.user>
		<flyway.password>ojpass</flyway.password>

		<!--
			★ PHẢI liệt kê MỌI thư mục mà ứng dụng nạp, kể cả db/dev-seed của profile dev.
			Thiếu một thư mục là `repair` GÂY RA hỏng chứ không sửa hỏng.

			Đã xảy ra 2026-09-10, mất 20 phút để lần ra: bản đầu của khối này để mặc định
			(chỉ db/migration). `flyway:repair` thấy R__seed_du_lieu_dev trong lịch sử mà
			không có file tương ứng, kết luận file đã bị xoá, và ghi một dòng tombstone
			type=DELETE. Từ đó Flyway coi seed ấy là CHƯA TỪNG CHẠY — nên lần khởi động kế
			tiếp nó chạy lại từ đầu, đâm vào ck_users_anonymized, và API không lên được.

			Nói cách khác: `repair` xoá lịch sử của mọi migration nó không nhìn thấy. Cho nó
			nhìn thiếu là cho nó xoá nhầm.

			`filesystem:` chứ không `classpath:` — plugin chỉ cần đọc file để tính checksum,
			không cần target/classes đã được dựng.

			★ `${project.basedir}` là BẮT BUỘC, đường dẫn tương đối KHÔNG chạy. Flyway giải
			`filesystem:` theo thư mục làm việc của JVM — tức nơi bạn gõ `mvn`, thường là gốc
			repo — chứ không theo thư mục module. Viết `filesystem:src/...` thì nó tìm
			`<gốc-repo>/src/...`, không thấy gì, và tombstone SẠCH cả hai seed. Đã đo đúng
			như vậy trước khi neo bằng basedir.
		-->
		<flyway.locations>filesystem:${project.basedir}/src/main/resources/db/migration,filesystem:${project.basedir}/src/main/resources/db/dev-seed</flyway.locations>
	</properties>

	<!--
		Spring Boot 4.1 khai báo ${testcontainers.version} (2.0.5) nhưng không quản trực tiếp
		từng artifact org.testcontainers:* — phải import BOM. Import ở đây để hai artifact dưới
		không tự ghi số và luôn khớp nhau: lệch version giữa chúng là lỗi chỉ hiện lúc chạy,
		dưới dạng NoSuchMethodError.

		⚠️ Testcontainers 2.x đổi tên artifact: `testcontainers-postgresql` chứ không phải
		`postgresql` như bản 1.x mà mọi hướng dẫn trên mạng còn viết.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!--
			JdbcClient + HikariCP: nền của DataSourceConfig (hai pool) và của mọi
			repository. Trước đây nó chỉ đến GIÁN TIẾP qua starter-flyway — nghĩa là
			một lần nâng phiên bản Flyway có thể làm cả hệ thống không biên dịch được.
			Khai báo thẳng ra.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!--
			BCrypt cost 12 — FR-AUTH-01, Bước 4.4. ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Cố ý là `spring-security-crypto` ĐƠN LẺ chứ không phải `spring-boot-starter-security`:

			  1. Starter đầy đủ tự bật chuỗi filter mặc định, khoá MỌI endpoint bằng HTTP Basic
			     với mật khẩu sinh ngẫu nhiên. Hệ thống này đã có lớp xác thực riêng —
			     InternalSecretFilter cho /internal, JwtAuthFilter cho /api/v1 — nên chuỗi
			     filter thứ hai chỉ là một cơ chế nữa phải cấu hình cho nó đừng làm gì.
			  2. Artifact này không kéo theo dependency nào và không kích hoạt auto-config nào.
			     Bề mặt thật sự thêm vào dự án đúng bằng một class: BCryptPasswordEncoder.

			KHÔNG tự viết BCrypt. Nó là lịch khoá Blowfish, không phải một vòng lặp băm.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!--
			Redis — Bước 3.8. Fan-out SSE qua pub/sub.

			ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2). Ba lý do nó vào ở tuần 5 chứ không tuần 7:

			  1. Redis đã có trong docker-compose từ M0, và `spring.data.redis` đã nằm sẵn
			     trong application.yml từ đó — thiếu đúng một dòng này.
			  2. Nó ĐÃ ở trong cây phụ thuộc, chỉ ở test scope (kéo theo bởi
			     spring-boot-starter-data-redis-test → Lettuce 7.5.2). Đây là đổi phạm vi,
			     không phải rước một thư viện lạ vào.
			  3. Làm bản in-memory trước rồi thay ở M4 là VIẾT HAI LẦN, và ở giữa có hai
			     tuần mà chạy 2 instance API là 50% người dùng mất realtime — instance đang
			     giữ kết nối SSE không phải instance nhận verdict. Xem ADR 011.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
			Markdown server-side — FR-PROB-02, Bước 4.9. ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Cố ý là commonmark chứ không phải flexmark: hai artifact, không transitive
			dependency, và quan trọng nhất — nó TẮT ĐƯỢC HTML thô bằng một tuỳ chọn.

			Đề bài do SETTER soạn và hiển thị cho MỌI thí sinh. Nếu bộ render cho phép HTML
			thô đi qua thì một thẻ <script> trong đề là XSS trên trang mà cả kỳ thi đang mở —
			và nó đọc được access token trong localStorage. `escapeHtml(true)` biến lỗ hổng
			ấy thành một quyết định cấu hình thay vì một bộ lọc HTML tự viết, thứ mà lịch sử
			ngành đã chứng minh là không ai viết đúng.

			LaTeX KHÔNG render ở đây: server giữ nguyên các đoạn toán, KaTeX vẽ ở trình duyệt.
			Xem javadoc của StatementRenderer.
		-->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
			<version>0.24.0</version>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
			<version>0.24.0</version>
		</dependency>

		<!--
			Kho testdata content-addressed — FR-PROB-03, Bước 4.11. ĐÃ ĐƯỢC DUYỆT (mục 5.2).

			MinIO đã chạy trong docker-compose.yml và OJ_MINIO_* đã có trong .env.example từ
			M0, tức là hạ tầng được chọn từ đầu; đây chỉ là phần Java còn thiếu.

			Chỉ sống trong problems.infrastructure, sau port TestdataStore. oj-worker KHÔNG
			có dependency này và không được có — bất biến #3.
		-->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.5.17</version>
		</dependency>

		<!--
			Actuator + Micrometer — Bước 6.7 (health thật) và 6.10 (P1–P8).
			ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Bảng SLO ở nfrplan.md Phần 1 ghi thẳng "Đo bằng: Micrometer" cho P1, P2 và R3.
			Tự viết một bộ đếm percentile là viết lại đúng phần khó của một thư viện đã đúng —
			p95 tính từ một histogram, không phải từ một biến trung bình.

			⚠️ Hai điều PHẢI cấu hình cùng lúc, xem application.yml:
			  1. management.server.port = 8081. Cloudflare Tunnel chỉ publish cổng 8080, nên
			     /actuator/** không có lối vào từ internet — cùng cách đã dùng cho
			     /internal/judge/*. Không có dòng đó thì /actuator/health lộ ra ngoài tunnel.
			  2. exposure.include chỉ có `health`. Mặc định của Boot đã hẹp, nhưng viết ra
			     tường minh để một lần "bật tạm cái env để xem" không mở luôn /actuator/env,
			     nơi có OJ_JWT_SECRET.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers — Postgres THẬT cho integration test, KHÔNG H2.
			H2 không có partial index, FOR UPDATE SKIP LOCKED, hay ON CONFLICT ... WHERE —
			tức là nó không có đúng ba thứ mà toàn bộ thiết kế hàng đợi dựa vào. Một bộ test
			xanh trên H2 sẽ nói dối về chính những bất biến quan trọng nhất (postgres-design
			mục 13, build-order Bước M1-7).

			@ServiceConnection của spring-boot-testcontainers tự nối container vào cấu hình.
			Cần vì hệ thống có HAI pool (oj.datasource.app / judge) phải trỏ cùng một container;
			bơm tay bằng @DynamicPropertySource là thêm hai chỗ để sai, và sai kiểu đó thì test
			vẫn xanh nhưng chạy nhầm pool.

			Phiên bản do BOM của Spring Boot quản — không tự ghi số.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.oj</groupId>
			<artifactId>oj-contract</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				★ BẮT BUỘC, nếu không thì toàn bộ integration test KHÔNG BAO GIỜ CHẠY.

				Surefire chỉ nhận *Test.java; các lớp *IT.java là việc của Failsafe, và nó
				không tự bật. Thiếu khối này thì `mvn verify` vẫn xanh trong khi bốn chaos
				test và SchemaInvariantsIT nằm im — tức là R1 và R2 lại quay về được ép bằng
				lời hứa, đúng thứ chúng sinh ra để thay thế.

				Failsafe chạy ở pha integration-test và `verify` mới báo lỗi, nên một IT đỏ
				không làm hỏng `mvn install` giữa chừng mà vẫn fail build. Phiên bản do
				parent của Spring Boot quản.

				⚠️ Cần Docker chạy được trên máy (Testcontainers). CI ubuntu-latest có sẵn.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!--
						★ Thứ tự CỐ ĐỊNH, và đây là một quyết định chứ không phải sở thích.

						Mặc định của Failsafe là `filesystem` — thứ tự thư mục trả về, tức là
						thứ tự tạo inode. Nó KHÁC NHAU giữa máy dev và runner CI, nên một bộ
						IT có phụ thuộc thứ tự sẽ xanh ở đây và đỏ ở kia, và không ai tái hiện
						được. Bộ IT này dùng CHUNG một Postgres (container singleton), nên
						phụ thuộc thứ tự là chuyện có thể xảy ra thật.

						`alphabetical` làm CI và máy dev chạy đúng một thứ tự. Nó không SỬA
						được phụ thuộc thứ tự — `PostgresIT.resetHotTables()` mới làm việc đó
						— nhưng nó biến "đỏ ngẫu nhiên ở một máy" thành "đỏ ở mọi máy", và
						một lỗi tái hiện được là một lỗi sửa được.
					-->
					<runOrder>alphabetical</runOrder>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<!--
					★ CỐ Ý KHÔNG ghi <version>. spring-boot-starter-parent quản lý nó bằng
					${flyway.version} — đúng con số đang dùng cho flyway-core (12.4.0). Ghi
					số ở đây là tạo ra một chỗ thứ hai để lệch, và lệch phiên bản Flyway
					nghĩa là thuật toán băm khác: `repair` ghi vào một checksum mà Flyway
					của ứng dụng không công nhận, rồi app vẫn đỏ y như trước khi repair.

					★ KHÔNG chạy trong vòng đời build. Không có <executions>, nên `mvn
					verify` không đụng tới nó. Đây là công cụ gọi tay khi có sự cố, không
					phải một bước của quy trình dựng.

					Việc duy nhất nó sinh ra để làm:

					    ./mvnw -pl oj-api flyway:repair

					dùng khi Flyway từ chối khởi động vì "checksum mismatch" — tức một file
					V__ đã commit bị sửa (điều #6 của CLAUDE.md). `repair` tính lại checksum
					từ file rồi ghi vào flyway_schema_history. Nó KHÔNG chạy lại migration.

					⚠️ `repair` chỉ đúng khi phần SQL THỰC THI không đổi. Nếu DDL có đổi thật
					thì repair là nói dối: nó tuyên bố "DB khớp file" trong khi DB thiếu đúng
					phần vừa thêm. Ca ấy phải trả file về bản đã commit rồi viết V<n+1> mới.
					Cách kiểm 30 giây: bỏ mọi dòng chú thích của hai bản rồi diff phần còn lại.
				-->
				<configuration>
					<!--
						★ Tắt `clean` VĨNH VIỄN, và đây là lý do plugin này suýt không đáng thêm.

						`mvn flyway:clean` XOÁ TOÀN BỘ schema — mọi bảng, mọi bài nộp, mọi
						verdict. Một lần gõ nhầm `clean` thay vì `repair` trên máy có dữ liệu
						thật là phá thẳng vào lời hứa số hai của hệ thống này ("không mất bài
						nộp"), và không có bước xác nhận nào chen vào giữa.

						Flyway 10+ mặc định đã là true, nhưng viết ra ở đây để nó là một quyết
						định đọc được, không phải một mặc định may mắn có thể đổi ở bản sau.
					-->
					<cleanDisabled>true</cleanDisabled>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>