	<properties>
		<java.version>21</java.version>

		<!--
			★ Ba giá trị này PHẢI khớp mặc định của `spring.flyway.*` trong
			application.yml. HopDongVanHanhTest đối chiếu hai file và đỏ khi chúng lệch.

			Vì sao đáng canh: `flyway:repair` sửa bảng `flyway_schema_history` của
			DATABASE mà nó nối tới. Lệch một chữ trong URL là nó sửa đúng thao tác ấy
			trên một database khác — thành công, im lặng, và cái đang hỏng thì vẫn hỏng.

			Đổi DB của app bằng OJ_DB_URL thì phải truyền -Dflyway.url tương ứng:
			Maven không có cú pháp ${BIEN:mac-dinh} như Spring, nên hai bên không tự
			bám theo nhau được. Ca kiểm chỉ giữ được phần MẶC ĐỊNH.
		-->
		<flyway.url>jdbc:postgresql://localhost:5432/ojdb</flyway.url>
		<flyway.user>ojuser</flyway.user>
		<flyway.password>ojpass</flyway.password>

		<!--
			★ PHẢI liệt kê MỌI thư mục mà ứng dụng nạp, kể cả db/dev-seed của profile dev.
			Thiếu một thư mục là `repair` GÂY RA hỏng chứ không sửa hỏng.

			Đã xảy ra 2026-09-10, mất 20 phút để lần ra: bản đầu của khối này để mặc định
			(chỉ db/migration). `flyway:repair` thấy R__seed_du_lieu_dev trong lịch sử mà
			không có file tương ứng, kết luận file đã bị xoá, và ghi một dòng tombstone
			type=DELETE. Từ đó Flyway coi seed ấy là CHƯA TỪNG CHẠY — nên lần khởi động kế
			tiếp nó chạy lại từ đầu, đâm vào ck_users_anonymized, và API không lên được.

			Nói cách khác: `repair` xoá lịch sử của mọi migration nó không nhìn thấy. Cho nó
			nhìn thiếu là cho nó xoá nhầm.

			`filesystem:` chứ không `classpath:` — plugin chỉ cần đọc file để tính checksum,
			không cần target/classes đã được dựng.

			★ `${project.basedir}` là BẮT BUỘC, đường dẫn tương đối KHÔNG chạy. Flyway giải
			`filesystem:` theo thư mục làm việc của JVM — tức nơi bạn gõ `mvn`, thường là gốc
			repo — chứ không theo thư mục module. Viết `filesystem:src/...` thì nó tìm
			`<gốc-repo>/src/...`, không thấy gì, và tombstone SẠCH cả hai seed. Đã đo đúng
			như vậy trước khi neo bằng basedir.
		-->
		<flyway.locations>filesystem:${project.basedir}/src/main/resources/db/migration,filesystem:${project.basedir}/src/main/resources/db/dev-seed</flyway.locations>

		<!--
			★ GHI ĐÈ VÌ CVE — gỡ từng dòng khi Spring Boot tự quản một bản ≥ bản ghi ở đây.

			Trivy (quet-phu-thuoc.yml) đỏ ở lần quét thật đầu tiên, 2026-09-24. Spring Boot
			4.1.1 là bản 4.1.x mới nhất lúc ấy và chính nó ghim hai bản có lỗ — nâng Boot
			không đủ, phải ghi đè thuộc tính mà parent dùng.

			tomcat 11.0.24 → 11.0.26: CVE-2026-65182 · 65905 · 68525, cả ba CRITICAL, vá từ
			  11.0.25. Hai cái sau nằm ở DIGEST/FORM authenticator của Tomcat, thứ ta không
			  dùng. Cái đầu là lỗi kiểm soát truy cập và CHƯA loại trừ được — mà Tomcat là
			  thứ nhận request từ internet.
			amqp-client 5.30.0 → 5.34.0: CVE-2026-63337 · 69219 · 69220 · 75516, HIGH.
			  oj-worker/pom.xml ghi đè CÙNG giá trị — sửa ở đây thì sửa cả ở đó.
		-->
		<tomcat.version>11.0.26</tomcat.version>
		<rabbit-amqp-client.version>5.34.0</rabbit-amqp-client.version>
	</properties>

	<!--
		Spring Boot 4.1 khai báo ${testcontainers.version} (2.0.5) nhưng không quản trực tiếp
		từng artifact org.testcontainers:* — phải import BOM. Import ở đây để hai artifact dưới
		không tự ghi số và luôn khớp nhau: lệch version giữa chúng là lỗi chỉ hiện lúc chạy,
		dưới dạng NoSuchMethodError.

		⚠️ Testcontainers 2.x đổi tên artifact: `testcontainers-postgresql` chứ không phải
		`postgresql` như bản 1.x mà mọi hướng dẫn trên mạng còn viết.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!--
				★ Bouncy Castle vào qua MinIO client, không do ta khai. MinIO 8.6.0 kéo 1.81
				(8.5.17 kéo 1.78.1) — còn bản vá của CVE-2026-8763 và
				CVE-2025-14813 (CRITICAL) và CVE-2026-13506 (HIGH) là 1.85. Nên phải ghim ở
				đây; nâng MinIO không đủ. Gỡ khối này khi MinIO tự kéo bản ≥ 1.85. Trivy 2026-09-24.
			-->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>1.85.2</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!--
			JdbcClient + HikariCP: nền của DataSourceConfig (hai pool) và của mọi
			repository. Trước đây nó chỉ đến GIÁN TIẾP qua starter-flyway — nghĩa là
			một lần nâng phiên bản Flyway có thể làm cả hệ thống không biên dịch được.
			Khai báo thẳng ra.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!--
			BCrypt cost 12 — FR-AUTH-01, Bước 4.4. ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Cố ý là `spring-security-crypto` ĐƠN LẺ chứ không phải `spring-boot-starter-security`:

			  1. Starter đầy đủ tự bật chuỗi filter mặc định, khoá MỌI endpoint bằng HTTP Basic
			     với mật khẩu sinh ngẫu nhiên. Hệ thống này đã có lớp xác thực riêng —
			     InternalSecretFilter cho /internal, JwtAuthFilter cho /api/v1 — nên chuỗi
			     filter thứ hai chỉ là một cơ chế nữa phải cấu hình cho nó đừng làm gì.
			  2. Artifact này không kéo theo dependency nào và không kích hoạt auto-config nào.
			     Bề mặt thật sự thêm vào dự án đúng bằng một class: BCryptPasswordEncoder.

			KHÔNG tự viết BCrypt. Nó là lịch khoá Blowfish, không phải một vòng lặp băm.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!--
			Redis — Bước 3.8. Fan-out SSE qua pub/sub.

			ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2). Ba lý do nó vào ở tuần 5 chứ không tuần 7:

			  1. Redis đã có trong docker-compose từ M0, và `spring.data.redis` đã nằm sẵn
			     trong application.yml từ đó — thiếu đúng một dòng này.
			  2. Nó ĐÃ ở trong cây phụ thuộc, chỉ ở test scope (kéo theo bởi
			     spring-boot-starter-data-redis-test → Lettuce 7.5.2). Đây là đổi phạm vi,
			     không phải rước một thư viện lạ vào.
			  3. Làm bản in-memory trước rồi thay ở M4 là VIẾT HAI LẦN, và ở giữa có hai
			     tuần mà chạy 2 instance API là 50% người dùng mất realtime — instance đang
			     giữ kết nối SSE không phải instance nhận verdict. Xem ADR 011.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
			SMTP — FR-AUTH-09 (V13), xác minh email. ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Ba điều cần biết trước khi ai đó định gỡ nó ra hay thay nó:

			  1. Đây là dependency DUY NHẤT của tính năng này. Đường còn lại — gọi HTTP API
			     của một nhà cung cấp thư (Resend, Brevo, SES) qua RestClient như
			     TurnstileVerifier đang làm — KHÔNG cần dependency nào cả. Đường SMTP được
			     chọn có chủ ý: nó chạy được với bất kỳ máy chủ thư nào, kể cả một hộp thư
			     Gmail thường, nên không khoá dự án vào một nhà cung cấp.

			  2. Nó KHÔNG kéo theo auto-config nào tự bật: Spring Boot chỉ dựng bean
			     JavaMailSender khi `spring.mail.host` có giá trị. Máy dev và bộ IT không đặt
			     biến ấy, nên bề mặt thật sự thêm vào lúc chạy test là BẰNG KHÔNG.

			  3. Nó nằm ngoài đường `nộp bài -> verdict`. Lá thư duy nhất hệ thống gửi là mã
			     xác minh, và nó đi từ cửa đăng ký cùng trang hồ sơ. Không một verdict nào
			     chờ SMTP (nfrplan 2.1).

			★ Mặc định của JavaMail là CHỜ VÔ HẠN. Ba timeout trong application.yml không
			  phải tuỳ chọn — SmtpEmailSender đọc lại chúng lúc boot và TỪ CHỐI khởi động
			  nếu thiếu. Xem javadoc ở đó để biết vì sao một trần thời gian không tới được
			  nơi cần là kiểu hỏng tệ nhất.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!--
			Markdown server-side — FR-PROB-02, Bước 4.9. ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Cố ý là commonmark chứ không phải flexmark: hai artifact, không transitive
			dependency, và quan trọng nhất — nó TẮT ĐƯỢC HTML thô bằng một tuỳ chọn.

			Đề bài do SETTER soạn và hiển thị cho MỌI thí sinh. Nếu bộ render cho phép HTML
			thô đi qua thì một thẻ <script> trong đề là XSS trên trang mà cả kỳ thi đang mở —
			và nó đọc được access token trong localStorage. `escapeHtml(true)` biến lỗ hổng
			ấy thành một quyết định cấu hình thay vì một bộ lọc HTML tự viết, thứ mà lịch sử
			ngành đã chứng minh là không ai viết đúng.

			LaTeX KHÔNG render ở đây: server giữ nguyên các đoạn toán, KaTeX vẽ ở trình duyệt.
			Xem javadoc của StatementRenderer.
		-->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
			<version>0.24.0</version>
		</dependency>
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark-ext-gfm-tables</artifactId>
			<version>0.24.0</version>
		</dependency>

		<!--
			Kho testdata content-addressed — FR-PROB-03, Bước 4.11. ĐÃ ĐƯỢC DUYỆT (mục 5.2).

			MinIO đã chạy trong docker-compose.yml và OJ_MINIO_* đã có trong .env.example từ
			M0, tức là hạ tầng được chọn từ đầu; đây chỉ là phần Java còn thiếu.

			Chỉ sống trong problems.infrastructure, sau port TestdataStore. oj-worker KHÔNG
			có dependency này và không được có — bất biến #3.

			8.6.0 chứ không 8.5.17: CVE-2025-59952 (HIGH — thay biến môi trường vào giá trị
			thẻ XML), Trivy 2026-09-24. Không lên 9.x: đổi bản chính là việc riêng.
			Được canh bởi MinioTestdataStoreIT, chạy trên MinIO thật.
		-->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>9.0.3</version>
		</dependency>

		<!--
			★ Phần JVM của OkHttp 5 — MinIO 8.6.0 cần nó mà không tự kéo được.
			ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2), 2026-09-24.

			OkHttp 5 là thư viện Kotlin đa nền tảng. Artifact `okhttp` mà MinIO khai chỉ là
			gốc: trên Maven Central nó nặng 767 byte, không có một class nào — Gradle đọc
			module metadata để tự chọn biến thể JVM, Maven thì không. Thiếu dòng này thì biên
			dịch hỏng ở `okhttp3.HttpUrl` (đo 2026-09-24).

			Phiên bản PHẢI khớp bản `okhttp` mà MinIO khai trong pom của nó. MinIO nâng OkHttp
			mà quên dòng này thì hai nửa lệch nhau: nửa rỗng mới, nửa chạy cũ.
			kotlin-stdlib đi theo kotlin.version do Spring Boot quản (2.3.x ≥ 2.2 OkHttp đòi).
		-->
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp-jvm</artifactId>
			<version>5.1.0</version>
		</dependency>

		<!--
			Actuator + Micrometer — Bước 6.7 (health thật) và 6.10 (P1–P8).
			ĐÃ ĐƯỢC DUYỆT (CLAUDE.md mục 5.2).

			Bảng SLO ở nfrplan.md Phần 1 ghi thẳng "Đo bằng: Micrometer" cho P1, P2 và R3.
			Tự viết một bộ đếm percentile là viết lại đúng phần khó của một thư viện đã đúng —
			p95 tính từ một histogram, không phải từ một biến trung bình.

			⚠️ Hai điều PHẢI cấu hình cùng lúc, xem application.yml:
			  1. management.server.port = 8081. Cloudflare Tunnel chỉ publish cổng 8080, nên
			     /actuator/** không có lối vào từ internet — cùng cách đã dùng cho
			     /internal/judge/*. Không có dòng đó thì /actuator/health lộ ra ngoài tunnel.
			  2. exposure.include chỉ có `health`. Mặc định của Boot đã hẹp, nhưng viết ra
			     tường minh để một lần "bật tạm cái env để xem" không mở luôn /actuator/env,
			     nơi có OJ_JWT_SECRET.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.3.0</version>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers — Postgres THẬT cho integration test, KHÔNG H2.
			H2 không có partial index, FOR UPDATE SKIP LOCKED, hay ON CONFLICT ... WHERE —
			tức là nó không có đúng ba thứ mà toàn bộ thiết kế hàng đợi dựa vào. Một bộ test
			xanh trên H2 sẽ nói dối về chính những bất biến quan trọng nhất (postgres-design
