<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.oj.sao-luu-goc</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@HOME@/oj-backup/bin/sao-luu-goc.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>OJ_DB_NAME</key>
        <string>ojdb_prod</string>
        <key>OJ_BASEBACKUP_DIR</key>
        <string>@HOME@/oj-backup/goc</string>
        <key>OJ_WAL_ARCHIVE_DIR</key>
        <string>@HOME@/oj-backup/wal</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@HOME@/oj-backup/sao-luu-goc.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/oj-backup/sao-luu-goc.log</string>

    <key>WorkingDirectory</key>
    <string>@HOME@/oj-backup</string>
</dict>
</plist>
