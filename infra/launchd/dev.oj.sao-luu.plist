<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.oj.sao-luu</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@HOME@/oj-backup/bin/sao-luu-db.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>OJ_DB_NAME</key>
        <string>ojdb_prod</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>@HOME@/oj-backup/sao-luu.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/oj-backup/sao-luu.log</string>

    <key>WorkingDirectory</key>
    <string>@HOME@/oj-backup</string>
</dict>
</plist>
