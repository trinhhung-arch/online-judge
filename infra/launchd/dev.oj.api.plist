<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.oj.api</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@HOME@/oj-release/bin/khoi-dong-api.sh</string>
        <string>chay</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>@HOME@/oj-release/api.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/oj-release/api.log</string>

    <key>WorkingDirectory</key>
    <string>@HOME@/oj-release</string>
</dict>
</plist>
