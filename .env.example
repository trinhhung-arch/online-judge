# =============================================================================
# Sao chép thành .env rồi điền. THIẾU BIẾN NÀO Ở NHÓM 1 LÀ API KHÔNG KHỞI ĐỘNG.
# Đó là hành vi cố ý (build-order.md Bước 0.5): một secret có giá trị mặc định
# là một secret công khai.
# =============================================================================

# ----- 1. Bắt buộc -----------------------------------------------------------
# Shared secret của hai endpoint /internal/judge/*. TỐI THIỂU 32 KÝ TỰ.
# Đây KHÔNG phải JWT người dùng — ai gọi được /internal với secret này thì ghi
# được verdict cho bất kỳ bài nộp nào. Sinh bằng: openssl rand -base64 48
OJ_INTERNAL_SHARED_SECRET=

# Khoá ký access token JWT (HS256). TỐI THIỂU 32 KÝ TỰ.
# Khác secret ở trên: cái trên cho worker, cái này cho người dùng. Dùng chung một
# chuỗi cho cả hai nghĩa là một worker bị lộ secret cũng tự phát được token ADMIN.
# Sinh bằng: openssl rand -base64 48
OJ_JWT_SECRET=

# Khoá mã hoá bí mật TOTP (2FA) lúc lưu vào database. TỐI THIỂU 32 KÝ TỰ.
# PHẢI KHÁC OJ_JWT_SECRET — API không khởi động nếu hai chuỗi bằng nhau. Lý do: xoay
# khoá ký token là việc vệ sinh nên làm định kỳ, còn xoay khoá này thì làm hỏng đăng ký
# 2FA của tất cả mọi người. Một khoá một việc.
# ⚠️ ĐỔI CHUỖI NÀY = MỌI NGƯỜI PHẢI ĐĂNG KÝ LẠI 2FA. Sao lưu nó cùng chỗ với database.
# Sinh bằng: openssl rand -base64 48
OJ_TOTP_KEY=

# Cloudflare Turnstile — chặn bot ở cửa đăng ký (FR-AUTH-01).
# MẶC ĐỊNH TẮT: máy dev và bộ IT không có khoá. Trên máy CÔNG KHAI hãy bật.
# Lấy cả hai khoá ở dashboard Cloudflare → Turnstile → Add site.
# Bật mà thiếu khoá thì API KHÔNG khởi động — một hàng rào bật-nhưng-không-cấu-hình
# là hàng rào tệ nhất, vì nó trông như đang bảo vệ.
OJ_TURNSTILE_ENABLED=false
OJ_TURNSTILE_SITE_KEY=
OJ_TURNSTILE_SECRET=
# Tên miền phục vụ trang đăng ký, phân tách bằng dấu phẩy. Bắt buộc khi bật: token giải ở
# nơi khác (kể cả localhost của người lạ) bị từ chối.
OJ_TURNSTILE_HOSTNAMES=

# Xác minh email — FR-AUTH-09 (V13). MỨC MỀM: nhãn users.email_verified_at KHÔNG chặn gì cả.
# Chưa xác minh thì vẫn đăng nhập, vẫn nộp bài, vẫn dự thi (docs/adr/016-...).
#
# ★ ĐÂY KHÔNG PHẢI HÀNG RÀO CHỐNG BOT — việc đó là của OJ_TURNSTILE_* ở trên. Tắt khối này
# KHÔNG hạ mức chống bot đi chút nào. Nó tồn tại để có một kênh liên lạc đã xác minh, thứ mà
# "quên mật khẩu qua email" sẽ dựa vào.
#
# MẶC ĐỊNH TẮT: máy dev và bộ IT không có máy chủ thư. Bật mà thiếu OJ_MAIL_FROM hoặc
# OJ_MAIL_HOST thì API KHÔNG khởi động — cùng lý do với Turnstile: bật mà không gửi được thì
# triệu chứng là "không ai nhận được mã", một kiểu hỏng im lặng phát hiện được hàng giờ sau.
OJ_EMAIL_VERIFICATION_ENABLED=false

# Địa chỉ người gửi. PHẢI thuộc tên miền đã cấu hình SPF và DKIM — không thì thư vào thẳng
# hộp spam, và "mã rơi vào spam" là trải nghiệm tệ hơn không có xác minh.
OJ_MAIL_FROM=

# Máy chủ SMTP. Để TRỐNG là tắt hẳn: Spring Boot chỉ dựng bean JavaMailSender khi biến này
# có giá trị, nên trống = không có bean = không có gì để cấu hình sai.
#
# Gmail dùng được: smtp.gmail.com cổng 587, username là địa chỉ Gmail, và OJ_MAIL_PASSWORD
# là MẬT KHẨU ỨNG DỤNG (App Password) — không phải mật khẩu tài khoản, Google đã chặn đường
# đó. Lưu ý hạn gửi của Gmail thường (~500 thư/ngày) và việc thư đi từ tên miền gmail.com
# chứ không phải tên miền của hệ thống.
OJ_MAIL_HOST=
OJ_MAIL_PORT=587
OJ_MAIL_USERNAME=
OJ_MAIL_PASSWORD=

# ----- 2. Database -----------------------------------------------------------
# ★ WAL ARCHIVING — R4. Bật 2026-09-21 (build-order.md PHẦN 0 quyết định F).
#
# BẮT BUỘC, không có mặc định: `docker compose up` DỪNG NGAY nếu thiếu. Cố ý — một giá trị
# mặc định ở đây nghĩa là WAL đi vào một thư mục không ai ngờ tới, và người ta chỉ phát hiện
# vào đúng hôm cần restore.
#
# PHẢI là đường dẫn TUYỆT ĐỐI (compose không hiểu ~), và phải NGOÀI thư mục dữ liệu Postgres:
# cả mục đích của nó là sống sót khi mất chính volume ấy.
#
# ⛔ THƯ MỤC NÀY PHẢI GHI ĐƯỢC BỞI USER postgres TRONG CONTAINER (uid 70), không phải bởi
# bạn. Không ghi được thì Postgres GIỮ LẠI mọi WAL chưa lưu, pg_wal phình tới khi đầy đĩa và
# DATABASE DỪNG HẲN. Tạo đúng cách:
#     mkdir -p "$HOME/oj-backup/wal" && chmod 777 "$HOME/oj-backup/wal"
# Rồi kiểm bằng ./scripts/kiem-wal.sh — nó chạy phép thử bằng ĐÚNG user postgres, vì
# `docker exec` mặc định là root và root ghi được vào thư mục mà postgres thì không.
OJ_WAL_ARCHIVE_DIR=

# Base backup VẬT LÝ (pg_basebackup), mỗi ngày. KHÔNG thừa so với bản pg_dump:
# WAL không replay lên một bản dump logic được, nên thiếu cái này thì kho WAL ở trên là
# một đống file không dùng được vào việc gì. Xem đầu scripts/sao-luu-goc.sh.
OJ_BASEBACKUP_DIR=
OJ_BASEBACKUP_KEEP=3

# ★ MỌI MẬT KHẨU HẠ TẦNG Ở FILE NÀY ĐỀU BẮT BUỘC, KHÔNG CÓ MẶC ĐỊNH.
# docker-compose.yml đọc chúng bằng ${BIEN:?} — thiếu là `docker compose` dừng ngay. Mặc định
# cũ (ojpass, ojminio123) nằm trong git, nên nó là mật khẩu công khai (xem đầu docker-compose.yml).
# Sinh bằng: openssl rand -hex 24   (hex: không ký tự nào phải thoát trong YAML, JDBC hay URI)

# Superuser `ojuser` — chỉ docker-compose dùng lúc khởi tạo volume. Sao lưu đi bằng socket
# trong container (`docker exec ... pg_dump`) nên không cần biến này.
OJ_POSTGRES_PASSWORD=

OJ_DB_URL=jdbc:postgresql://localhost:5432/ojdb
OJ_DB_APP_USER=ojuser
# Máy dev đi bằng ojuser: đặt BẰNG OJ_POSTGRES_PASSWORD. Host thật đi bằng oj_app: mật khẩu riêng.
OJ_DB_APP_PASSWORD=

# Quyết định D (postgres-design.md mục 9): HAI role, không phải một.
#   oj_migrator  sở hữu schema, chạy Flyway, có DDL
#   oj_app       chỉ DML, bị REVOKE DELETE/TRUNCATE trên submissions (V8)
#
# Phần GRANT nằm ở V8__phan_quyen_role_ung_dung.sql — đã chạy. V8 tự bỏ qua trong im lặng
# nếu role oj_app chưa tồn tại, nên máy dev không cần làm gì.
#
# ★ Bật hai role trên host thật, đúng thứ tự này:
#     1. tạo role oj_app và oj_migrator (docker-compose đã tạo sẵn)
#     2. đặt OJ_DB_MIGRATOR_USER/PASSWORD ở dưới  <- Flyway đi bằng role này
#     3. đổi OJ_DB_APP_USER=oj_app ở trên          <- ứng dụng đi bằng role kia
#
# Bước 2 phải TRƯỚC bước 3. Làm ngược lại thì Flyway cũng chạy bằng oj_app — role vừa bị
# lấy hết quyền DDL — và migration kế tiếp chết với `permission denied for schema public`.
# Để TRỐNG (comment) cho tới khi làm xong bước 1: nếu đặt tên role mà chưa cấp quyền
# CREATE trên schema public cho nó, Flyway đổi role xong là chết ngay lần chạy đầu.
# Bỏ trống thì cả hai tự lùi về OJ_DB_APP_USER, đúng như hành vi từ trước tới nay.
# Mật khẩu mặc định do infra/postgres/init/01-roles.sql đặt: ojmigrator / ojapp — CÔNG KHAI
# trong git. Trên host thật đổi ngay bằng `ALTER ROLE oj_app PASSWORD ...` (và oj_migrator).
#OJ_DB_MIGRATOR_USER=oj_migrator
#OJ_DB_MIGRATOR_PASSWORD=ojmigrator
OJ_DB_APP_ROLE_PASSWORD=

# ----- 3. Hạ tầng phụ --------------------------------------------------------
# HSTS — Strict-Transport-Security. MẶC ĐỊNH 0s = TẮT, và đó là mặc định đúng
# cho máy dev: trình duyệt NHỚ HSTS kể cả sau khi header biến mất, nên bật nhầm
# trên localhost là tự khoá mọi cổng http://localhost của chính mình, gỡ ra phải
# vào chrome://net-internals/#hsts.
#
# ★ TRÊN MÁY CÔNG KHAI HÃY ĐẶT 365d. Đây là biến DUY NHẤT trong nhóm bảo mật mà
# để trống thì API vẫn khởi động bình thường và không cảnh báo gì — năm header kia
# luôn được gửi, riêng cái này im lặng vắng mặt. `scripts/kiem-tunnel.sh` là chỗ
# duy nhất nhắc, và chỉ khi có người chạy nó.
OJ_HSTS_MAX_AGE=0s

OJ_REDIS_HOST=localhost
OJ_REDIS_PORT=6379
# docker-compose bật --requirepass bằng biến này, oj-api đọc cùng biến (spring.data.redis.password).
OJ_REDIS_PASSWORD=
OJ_RABBIT_HOST=localhost
OJ_RABBIT_PORT=5672
OJ_RABBIT_USER=ojuser
OJ_RABBIT_PASSWORD=

# MinIO — testdata content-addressed, dùng từ M4 (FR-PROB-03)
OJ_MINIO_ENDPOINT=http://localhost:9000
OJ_MINIO_ACCESS_KEY=ojminio
OJ_MINIO_SECRET_KEY=

# ----- 4. Worker (oj-worker, tiến trình riêng) -------------------------------
# Worker KHÔNG có biến DB nào — nó không có DataSource (bất biến #3).
OJ_API_BASE_URL=http://localhost:8080
OJ_WORKER_HOST_NAME=mac-m1max-host
OJ_WORKER_ARCH=arm64
OJ_WORKER_SLOTS=6

# ----- 5. Sandbox (M2) -------------------------------------------------------
# Mọi biến ở nhóm này CÓ mặc định hợp lý; để trống là dùng mặc định.
#
# false = giữ ScriptedJudgeRunner của M1. KHÔNG phải cửa hậu bỏ sandbox: với
# false thì không một dòng mã người dùng nào được thực thi cả.
OJ_SANDBOX_ENABLED=true
OJ_ISOLATE_BIN=/usr/local/bin/isolate
OJ_ISOLATE_BOX_ROOT=/var/local/lib/isolate

# Hai worker trên CÙNG một máy phải đặt lệch nhau, nếu không chúng giành box
# của nhau và triệu chứng là những lượt IE ngẫu nhiên không tái hiện được.
OJ_WORKER_FIRST_BOX_ID=0

# Cache binary đã biên dịch + testdata đã tải. NGOÀI box_root — testdata nằm
# trong box là bất biến #1 bị phá.
OJ_WORKER_CACHE_DIR=/var/tmp/oj-worker

# Thời gian tải chuẩn (ms CPU) đo trên MÁY CHẤM CHUẨN. 0 = chưa hiệu chuẩn:
# worker vẫn đo và vẫn cảnh báo throttle nhiệt, nhưng không đổi giới hạn chấm.
# Điền sau khi deploy Mac (Bước 2.10) — xem bảng baseline trong README.
OJ_HOST_REFERENCE_CPU_MS=0
