# =============================================================================
# Sao chép thành .env rồi điền. THIẾU BIẾN NÀO Ở NHÓM 1 LÀ API KHÔNG KHỞI ĐỘNG.
# Đó là hành vi cố ý (build-order.md Bước 0.5): một secret có giá trị mặc định
# là một secret công khai.
# =============================================================================

# ----- 1. Bắt buộc -----------------------------------------------------------
# Shared secret của hai endpoint /internal/judge/*. TỐI THIỂU 32 KÝ TỰ.
# Đây KHÔNG phải JWT người dùng — ai gọi được /internal với secret này thì ghi
# được verdict cho bất kỳ bài nộp nào. Sinh bằng: openssl rand -base64 48
OJ_INTERNAL_SHARED_SECRET=

# Khoá ký access token JWT (HS256). TỐI THIỂU 32 KÝ TỰ.
# Khác secret ở trên: cái trên cho worker, cái này cho người dùng. Dùng chung một
# chuỗi cho cả hai nghĩa là một worker bị lộ secret cũng tự phát được token ADMIN.
# Sinh bằng: openssl rand -base64 48
OJ_JWT_SECRET=

# ----- 2. Database -----------------------------------------------------------
OJ_DB_URL=jdbc:postgresql://localhost:5432/ojdb
OJ_DB_APP_USER=ojuser
OJ_DB_APP_PASSWORD=ojpass

# Quyết định D (postgres-design.md mục 9): HAI role, không phải một.
#   oj_migrator  sở hữu schema, chạy Flyway, có DDL
#   oj_app       chỉ DML, bị REVOKE DELETE/TRUNCATE trên submissions (V8)
#
# Phần GRANT nằm ở V8__phan_quyen_role_ung_dung.sql — đã chạy. V8 tự bỏ qua trong im lặng
# nếu role oj_app chưa tồn tại, nên máy dev không cần làm gì.
#
# ★ Bật hai role trên host thật, đúng thứ tự này:
#     1. tạo role oj_app và oj_migrator (docker-compose đã tạo sẵn)
#     2. đặt OJ_DB_MIGRATOR_USER/PASSWORD ở dưới  <- Flyway đi bằng role này
#     3. đổi OJ_DB_APP_USER=oj_app ở trên          <- ứng dụng đi bằng role kia
#
# Bước 2 phải TRƯỚC bước 3. Làm ngược lại thì Flyway cũng chạy bằng oj_app — role vừa bị
# lấy hết quyền DDL — và migration kế tiếp chết với `permission denied for schema public`.
# Để TRỐNG (comment) cho tới khi làm xong bước 1: nếu đặt tên role mà chưa cấp quyền
# CREATE trên schema public cho nó, Flyway đổi role xong là chết ngay lần chạy đầu.
# Bỏ trống thì cả hai tự lùi về OJ_DB_APP_USER, đúng như hành vi từ trước tới nay.
# Mật khẩu mặc định do infra/postgres/init/01-roles.sql đặt: ojmigrator / ojapp.
#OJ_DB_MIGRATOR_USER=oj_migrator
#OJ_DB_MIGRATOR_PASSWORD=ojmigrator
OJ_DB_APP_ROLE_PASSWORD=

# ----- 3. Hạ tầng phụ --------------------------------------------------------
OJ_REDIS_HOST=localhost
OJ_REDIS_PORT=6379
OJ_RABBIT_HOST=localhost
OJ_RABBIT_PORT=5672
OJ_RABBIT_USER=ojuser
OJ_RABBIT_PASSWORD=ojpass

# MinIO — testdata content-addressed, dùng từ M4 (FR-PROB-03)
OJ_MINIO_ENDPOINT=http://localhost:9000
OJ_MINIO_ACCESS_KEY=ojminio
OJ_MINIO_SECRET_KEY=

# ----- 4. Worker (oj-worker, tiến trình riêng) -------------------------------
# Worker KHÔNG có biến DB nào — nó không có DataSource (bất biến #3).
OJ_API_BASE_URL=http://localhost:8080
OJ_WORKER_HOST_NAME=mac-m1max-host
OJ_WORKER_ARCH=arm64
OJ_WORKER_SLOTS=6

# ----- 5. Sandbox (M2) -------------------------------------------------------
# Mọi biến ở nhóm này CÓ mặc định hợp lý; để trống là dùng mặc định.
#
# false = giữ ScriptedJudgeRunner của M1. KHÔNG phải cửa hậu bỏ sandbox: với
# false thì không một dòng mã người dùng nào được thực thi cả.
OJ_SANDBOX_ENABLED=true
OJ_ISOLATE_BIN=/usr/local/bin/isolate
OJ_ISOLATE_BOX_ROOT=/var/local/lib/isolate

# Hai worker trên CÙNG một máy phải đặt lệch nhau, nếu không chúng giành box
# của nhau và triệu chứng là những lượt IE ngẫu nhiên không tái hiện được.
OJ_WORKER_FIRST_BOX_ID=0

# Cache binary đã biên dịch + testdata đã tải. NGOÀI box_root — testdata nằm
# trong box là bất biến #1 bị phá.
OJ_WORKER_CACHE_DIR=/var/tmp/oj-worker

# Thời gian tải chuẩn (ms CPU) đo trên MÁY CHẤM CHUẨN. 0 = chưa hiệu chuẩn:
# worker vẫn đo và vẫn cảnh báo throttle nhiệt, nhưng không đổi giới hạn chấm.
# Điền sau khi deploy Mac (Bước 2.10) — xem bảng baseline trong README.
OJ_HOST_REFERENCE_CPU_MS=0
